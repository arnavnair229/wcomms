#!/bin/sh
# API lane: run a headless Claude Code task on an API key, never on the subscription window.
#
#   wforge-bulk [-m haiku|sonnet|opus] [-e low|medium|high] [--cwd DIR] "task"
#
# Refuses to run without ANTHROPIC_API_KEY, because a plan-login `claude -p` drains the
# 5-hour window about twice as fast as an interactive session. Max, Ultra and Team plans
# include monthly API credits that cover exactly this path (see README, API lane).
set -eu
HERE=$(cd "$(dirname "$0")" && pwd)
PLUGIN=$(cd "$HERE/.." && pwd)
MODEL=haiku
EFFORT=low
DIR=$(pwd)
while [ $# -gt 0 ]; do
  case "$1" in
    -m) MODEL=$2; shift 2 ;;
    -e) EFFORT=$2; shift 2 ;;
    --cwd) DIR=$2; shift 2 ;;
    -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
    *) break ;;
  esac
done
[ $# -ge 1 ] || { echo "usage: wforge-bulk [-m model] [-e effort] [--cwd DIR] \"task\"" >&2; exit 2; }
if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
  echo "wforge-bulk: ANTHROPIC_API_KEY is not set. This lane exists so bulk work never touches your" >&2
  echo "subscription window. Export a key from the Console org linked to your plan credits, then retry." >&2
  exit 3
fi
cd "$DIR"
exec claude -p "$*" \
  --model "$MODEL" \
  --effort "$EFFORT" \
  --plugin-dir "$PLUGIN" \
  --output-format text \
  --permission-mode acceptEdits
