#!/bin/sh
# Overnight loop on the API lane: small committed steps toward one objective while you sleep.
#
#   wforge-nightshift [-n MAX_ITER] [-H MAX_HOURS] [-m haiku|sonnet|opus] [-c "check command"] [--cwd DIR] "objective"
#
# Each iteration runs one headless Claude Code turn that makes one small change and appends a line to
# NIGHTSHIFT.md. If the check command passes (or none is set) the change is committed; otherwise the
# working tree is reset to the last commit and the failure is logged. Stops at MAX_ITER (default 20),
# MAX_HOURS (default 6), when .wforge/nightshift.stop exists, or when an iteration makes no change twice.
#
# Refuses without ANTHROPIC_API_KEY: a plan-login `claude -p` drains the 5-hour window about twice as
# fast as interactive use, and an unattended loop is the fastest way to wake up to a locked account.
# Works on a fresh branch wforge/night-<date>, never on main, and never pushes.
set -eu
HERE=$(cd "$(dirname "$0")" && pwd)
PLUGIN=$(cd "$HERE/.." && pwd)
MAX_ITER=20
MAX_HOURS=6
MODEL=sonnet
CHECK=""
DIR=$(pwd)
while [ $# -gt 0 ]; do
  case "$1" in
    -n) MAX_ITER=$2; shift 2 ;;
    -H) MAX_HOURS=$2; shift 2 ;;
    -m) MODEL=$2; shift 2 ;;
    -c) CHECK=$2; shift 2 ;;
    --cwd) DIR=$2; shift 2 ;;
    -h|--help) sed -n '2,13p' "$0"; exit 0 ;;
    *) break ;;
  esac
done
[ $# -ge 1 ] || { echo "usage: wforge-nightshift [-n N] [-H HOURS] [-m model] [-c check] [--cwd DIR] \"objective\"" >&2; exit 2; }
OBJECTIVE=$*
if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
  echo "wforge-nightshift: ANTHROPIC_API_KEY is not set. This loop only runs on the API lane." >&2
  exit 3
fi
cd "$DIR"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "not a git repository" >&2; exit 2; }
if [ -n "$(git status --porcelain)" ]; then
  echo "working tree is not clean; commit or stash first" >&2
  exit 2
fi
case "$(git branch --show-current)" in
  main|master) ;;
  *) echo "start from main or master so the night branch has a known base" >&2; exit 2 ;;
esac
STAMP=$(date +%Y%m%d-%H%M)
BRANCH="wforge/night-$STAMP"
git checkout -b "$BRANCH" >/dev/null
mkdir -p .wforge
LOG=.wforge/nightshift.log
STOP=.wforge/nightshift.stop
rm -f "$STOP"
START=$(date +%s)
DEADLINE=$((START + MAX_HOURS * 3600))
NOCHANGE=0
COMMITS=0
echo "$(date '+%F %T') start branch=$BRANCH model=$MODEL max_iter=$MAX_ITER max_hours=$MAX_HOURS" >> "$LOG"
echo "nightshift on $BRANCH; log: $LOG; touch $STOP to end early"
i=1
while [ "$i" -le "$MAX_ITER" ]; do
  [ -f "$STOP" ] && { echo "$(date '+%F %T') stop file found" >> "$LOG"; break; }
  [ "$(date +%s)" -lt "$DEADLINE" ] || { echo "$(date '+%F %T') time cap reached" >> "$LOG"; break; }
  PROMPT="You are one iteration of an overnight loop. OBJECTIVE: $OBJECTIVE
Read NIGHTSHIFT.md if it exists to see what earlier iterations did. Make exactly ONE small, safe,
self-contained improvement toward the objective. Do not refactor broadly, do not add dependencies,
do not touch CI or deploy configuration. Then append one line to NIGHTSHIFT.md: '- iteration $i: <what you did and why>'.
If nothing safe is left to do, append '- iteration $i: nothing left' and change nothing else."
  set +e
  claude -p "$PROMPT" --model "$MODEL" --effort medium --plugin-dir "$PLUGIN" \
    --output-format text --permission-mode acceptEdits > ".wforge/nightshift-$i.out" 2>&1
  RC=$?
  set -e
  if [ -z "$(git status --porcelain)" ]; then
    NOCHANGE=$((NOCHANGE + 1))
    echo "$(date '+%F %T') iter $i: no change (rc=$RC)" >> "$LOG"
    [ "$NOCHANGE" -ge 2 ] && { echo "$(date '+%F %T') two idle iterations, stopping" >> "$LOG"; break; }
    i=$((i + 1)); continue
  fi
  NOCHANGE=0
  if [ -n "$CHECK" ]; then
    set +e
    sh -c "$CHECK" > ".wforge/nightshift-$i.check" 2>&1
    CRC=$?
    set -e
    if [ "$CRC" -ne 0 ]; then
      git checkout -- . && git clean -fdq
      echo "$(date '+%F %T') iter $i: check failed (rc=$CRC), rolled back" >> "$LOG"
      i=$((i + 1)); continue
    fi
  fi
  git add -A
  git commit -qm "nightshift $i: $(tail -n 1 NIGHTSHIFT.md 2>/dev/null | cut -c1-72)" || true
  COMMITS=$((COMMITS + 1))
  echo "$(date '+%F %T') iter $i: committed" >> "$LOG"
  i=$((i + 1))
done
ELAPSED=$(( ($(date +%s) - START) / 60 ))
echo "$(date '+%F %T') end commits=$COMMITS elapsed_min=$ELAPSED" >> "$LOG"
echo "nightshift done: $COMMITS commits on $BRANCH in $ELAPSED min"
echo "review:  git log --oneline main..$BRANCH && git diff main...$BRANCH --stat"
